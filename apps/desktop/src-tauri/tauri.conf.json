{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SCSMS",
  "version": "1.0.4",
  "identifier": "ke.go.scsms.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "scsms",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/school-logos/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNjExMUVBOUNFQTgwQTUKUldTbGdPcWM2aEZoa2tUMW5NeVJDaVVlckRmQVhkQmM0djBtanJyY2QvZzlPYnhTUEFKd2FnYkIK",
      "endpoints": [
        "https://github.com/JMakoti/SCSMS/releases/latest/download/latest.json"
      ]
    }
  }
}
