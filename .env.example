python - <<'PY'
import sqlite3
from pathlib import Path

database = Path("apps/desktop/src-tauri/scsms.db")
if not database.is_file():
    raise SystemExit(f"Database not found: {database.resolve()}")

email = input("Email of the account to make administrator: ").strip().lower()

with sqlite3.connect(str(database)) as connection:
    connection.execute("PRAGMA foreign_keys = ON")

    role = connection.execute(
        "SELECT id FROM roles WHERE name = ?",
        ("administrator",),
    ).fetchone()
    account = connection.execute(
        "SELECT id, name FROM users WHERE lower(email) = ?",
        (email,),
    ).fetchone()

    if role is None:
        raise SystemExit("Administrator role not found. Start the desktop app once to seed it.")
    if account is None:
        raise SystemExit("Account not found. Register it in the desktop app first.")

    connection.execute(
        """UPDATE users
           SET role_id = ?, status = 'active', updated_at = CURRENT_TIMESTAMP
           WHERE id = ?""",
        (role[0], account[0]),
    )
    print(f"Activated administrator: {account[1]} ({email})")
PY



